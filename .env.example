# AEM hosts
AEM_PUBLISH_HOST=https://publish-xxxx.adobeaemcloud.com
AEM_AUTHOR_HOST=https://author-xxxx.adobeaemcloud.com
AEM_GRAPHQL_PROJECT=wknd-shared
AEM_REVALIDATE_SECONDS=3600

# Universal Editor (browser / meta tags)
NEXT_PUBLIC_AEM_CONNECTION=
NEXT_PUBLIC_AEM_HOST=https://author-xxxx.adobeaemcloud.com
NEXT_PUBLIC_AEM_PUBLISH_HOST=https://publish-xxxx.adobeaemcloud.com
# Optional extra UE parent hostnames (comma-separated). AEM_AUTHOR_HOST is added automatically.
UE_ALLOWED_REFERER_HOSTS=

# Adobe IMS — server-side JWT for AEM_AUTHOR_HOST (technical account)
AEM_IMS_ENDPOINT=ims-na1.adobelogin.com
AEM_IMS_CLIENT_ID=
AEM_IMS_CLIENT_SECRET=
AEM_IMS_ORG_ID=000000000000000000000000@AdobeOrg
AEM_IMS_TECHNICAL_ACCOUNT_ID=000000000000000000000000@techacct.adobe.com
AEM_IMS_METASCOPES=ent_aem_cloud_api
# PEM private key from Developer Console (single line with \n between lines)
AEM_IMS_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nREPLACE_ME\n-----END PRIVATE KEY-----"
# Optional: read key from file instead of AEM_IMS_PRIVATE_KEY
# AEM_IMS_PRIVATE_KEY_PATH=./secrets/aem-ims-private.key
# AEM_IMS_PRIVATE_KEY_PASSPHRASE=
